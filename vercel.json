{
  "name": "b2b-travel-news",
  "outputDirectory": "output",
  "trailingSlash": false,
  "public": true,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
